# --- Dependencies ---
node_modules/
.pnpm-store/
.yarn/
.npm/

# --- Build output ---
dist/
build/
out/
.next/
.turbo/
.vercel/
*.tsbuildinfo

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- Testing / coverage ---
coverage/
.nyc_output/

# --- Foundry / Solidity ---
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/*/1337/
!contracts/broadcast/**/run-latest.json
# run-latest.json is the shared deployment record; the timestamped copies are duplicates of it.
contracts/broadcast/**/run-[0-9]*.json
# contracts/lib/ holds git submodules (forge-std), tracked as gitlinks -- do not ignore it.
*.pyc
__pycache__/

# --- Circom / snarkjs ---
# Most build/ceremony artifacts are large + regeneratable from the circuit source -- ignored.
# EXCEPTION: the final frozen proving key (zkey), its wasm witness calculator, and the
# verification key are committed on purpose. contracts/src/JudgesGroth16Verifier.sol embeds this
# exact zkey's verification key as constants -- a fresh clone must be able to generate proofs
# against the SAME zkey/wasm without re-running the trusted setup (which would produce a
# different, incompatible key and break every already-deployed verifier). See prover/README.md.
!prover/build/
prover/build/*
!prover/build/judges_membership_final.zkey
!prover/build/verification_key.json
!prover/build/judges_membership_js/
prover/build/judges_membership_js/*
!prover/build/judges_membership_js/judges_membership.wasm
prover/**/*.ptau
prover/**/witness.wtns

# --- graphify (codebase graph) ---
# graph.json, graph.html, GRAPH_REPORT.md and manifest.json are shared on purpose. The rest is this
# machine's cache, interpreter path, scan root and token log.
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/cost.json
graphify-out/__pycache__/

# --- Docker ---
docker/**/*.local.yml
docker/volumes/

# --- Database / cache local state ---
*.sqlite
*.sqlite3
pgdata/
redis-data/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
.claude/settings.local.json

# --- Packed npm tarballs (regenerate with `pnpm pack`) ---
*.tgz

# --- Misc local scratch ---
*.tmp
*.bak
.cache/

# The external-dapp example installs @judges/sdk from a locally packed tarball whose integrity hash
# changes on every repack, so a committed lockfile would break `npm ci` for everyone else.
examples/external-dapp/package-lock.json

# Redesign B browser-proving artifacts (large, regeneratable; served at runtime)
apps/web/public/prover/**/*.wasm
apps/web/public/prover/**/*.zkey
apps/web/public/prover/*.zkey
