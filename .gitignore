*.sqlite
*.sqlite3
pgdata/
redis-data/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- Misc local scratch ---
*.tmp
*.bak
.cache/
