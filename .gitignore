dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- Testing / coverage ---
coverage/
.nyc_output/

# --- Foundry / Solidity ---
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/*/1337/
!contracts/broadcast/**/run-latest.json
