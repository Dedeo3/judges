# --- Chain RPC ---
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=

# --- Contract explorer verification (fill in once known) ---
MONAD_TESTNET_EXPLORER_API_URL=
MONAD_TESTNET_EXPLORER_API_KEY=
MONAD_MAINNET_EXPLORER_API_URL=
MONAD_MAINNET_EXPLORER_API_KEY=

# --- Deploying ---
# The deploy script never reads a key from the environment. Pass the signer to forge instead
# (--keystore / --ledger / --private-key) so key handling stays outside the repo. See
# docs/deployment.md.
# Optional: faucet claim amount in wei (default 0.01 ether).
FAUCET_CLAIM_AMOUNT=

# --- Datastores (production: Neon + Upstash, both free tier) ---
# Local dev fallback (docker compose): postgresql://judges:judges@localhost:5432/judges
DATABASE_URL=
# Use the Neon POOLED connection string (pgbouncer) for serverless functions
DATABASE_URL_UNPOOLED=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- WebAuthn / Relying Party ---
# RP_ID must be the bare hostname users visit (no scheme, no port). WebAuthn is origin-scoped:
# a mismatch fails every ceremony with an opaque browser error, and passkeys registered against
# one hostname won't work on another.
RP_ID=localhost
RP_ORIGIN=http://localhost:3000
RP_NAME=Judges

# --- Domain separation secret for commitment/nullifier derivation ---
# Load-bearing and effectively permanent: every credential secret, commitment, and nullifier is
# derived from it. Rotating it invalidates every registered passkey and orphans every nullifier
# already consumed on-chain. Generate once with `openssl rand -hex 32` and back it up.
JUDGES_DOMAIN_SECRET=

# --- Frontend (NEXT_PUBLIC_*, safe to expose) ---
# Written paste-ready to contracts/deployments/<chainId>.env by the deploy script.
NEXT_PUBLIC_JUDGES_NETWORK=monad-testnet
NEXT_PUBLIC_JUDGES_VERIFIER_ADDRESS=
NEXT_PUBLIC_JUDGES_DAO_ADDRESS=
NEXT_PUBLIC_JUDGES_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_JUDGES_FAUCET_ADDRESS=
