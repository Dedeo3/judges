{
  "name": "@judges/video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts JudgesDemo out/judges-demo.raw.mp4 && node scripts/finish.mjs out/judges-demo.raw.mp4 out/judges-demo.mp4",
    "still": "remotion still src/index.ts JudgesDemo out/judges-demo.png",
    "contact": "remotion still src/dev/index.tsx Contact out/contact.png",
    "voice": "node --env-file=.env scripts/voiceover.mjs",
    "audio": "node scripts/audio-assets.mjs",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "zod": "4.5.4"
  }
}
